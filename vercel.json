{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/admin/:match*",
      "destination": "https://sjnamkshicpxtyikzsnp.supabase.co/functions/v1/admin/:match*"
    },
    {
      "source": "/api/auth/:match*",
      "destination": "https://sjnamkshicpxtyikzsnp.supabase.co/functions/v1/auth/:match*"
    },
    {
      "source": "/api/download/:match*",
      "destination": "https://sjnamkshicpxtyikzsnp.supabase.co/functions/v1/download/:match*"
    },
    {
      "source": "/api/download",
      "destination": "https://sjnamkshicpxtyikzsnp.supabase.co/functions/v1/download"
    },
    {
      "source": "/api/metadata/:match*",
      "destination": "https://sjnamkshicpxtyikzsnp.supabase.co/functions/v1/metadata/:match*"
    },
    {
      "source": "/api/metadata",
      "destination": "https://sjnamkshicpxtyikzsnp.supabase.co/functions/v1/metadata"
    },
    {
      "source": "/api/:match*",
      "destination": "https://sjnamkshicpxtyikzsnp.supabase.co/functions/v1/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
