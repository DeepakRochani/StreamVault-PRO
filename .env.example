# ============================================================
# StreamVault PRO — Environment Configuration Template
# ============================================================

# ── Server Configuration ─────────────────────────────────────
PORT=10000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_change_in_production
ALLOWED_ORIGIN=http://localhost:3000

# ── Storage & Binaries ───────────────────────────────────────
DOWNLOAD_PATH=./uploads
# Optional custom paths to external binaries (if not using bundled bin/ or system PATH)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# ── Supabase Configuration (Web / Cloud Sync) ────────────────
SUPABASE_URL=https://sjnamkshicpxtyikzsnp.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
# SUPABASE_SECRET_KEY is only used server-side if token validation is enabled
# SUPABASE_SECRET_KEY=your_supabase_service_or_secret_key

# ── Optional External APIs ───────────────────────────────────
# YOUTUBE_API_KEY=your_optional_youtube_data_api_v3_key
