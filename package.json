{
  "name": "streamvault-downloader",
  "version": "1.0.0",
  "description": "StreamVault PRO 4K Social Video Downloader Stitch Project",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "test": "node tests/ytdlp.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "concurrently \"npm run server\" \"electron .\"",
    "dist": "electron-builder",
    "desktop:build": "npm run build && electron-builder --config electron-builder.desktop.json",
    "desktop:mac": "npm run build && electron-builder --config electron-builder.desktop.json --mac",
    "desktop:mac:arm64": "npm run build && electron-builder --config electron-builder.desktop.json --mac --arm64",
    "desktop:mac:x64": "npm run build && electron-builder --config electron-builder.desktop.json --mac --x64",
    "desktop:win": "npm run build && electron-builder --config electron-builder.desktop.json --win --x64",
    "desktop:all": "npm run build && electron-builder --config electron-builder.desktop.json -mw"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.4.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@jerrycoder/instagram-api": "^2.5.9",
    "@xaviabot/fb-downloader": "^1.0.14",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "btch-downloader": "^6.3.6",
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "fluent-ffmpeg": "^2.1.3",
    "instagram-url-direct": "^2.0.7",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "play-dl": "^1.9.7",
    "snapsave-media-downloader": "^2.4.0"
  },
  "build": {
    "appId": "com.streamvault.pro",
    "productName": "StreamVault PRO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "server.js",
      "auth.js",
      "admin.js",
      "ads.js",
      "database.js",
      "global-status.js",
      "payment.js",
      "settings.js",
      "updater-api.js",
      "updater.js",
      "providers/**/*",
      "services/**/*",
      "public/**/*",
      "node_modules/**/*",
      "bin/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "asar": false
  }
}
